# Copy to the path in RECAP_ENV_FILE (default ~/secrets/recap.env), chmod 600,
# and fill in. run_recap.py loads this file, then falls back to process env.

# --- Fireflies ---
FIREFLIES_API_KEY=ff_xxxxxxxxxxxxxxxx

# --- Composio (Gmail) ---
COMPOSIO_API_KEY=ak_xxxxxxxxxxxxxxxx
COMPOSIO_USER_ID=user_xxxxx

# --- Linear ---
# Workspace API key used for catalog reads, issue search, completion, and create.
LINEAR_API_KEY=lin_api_xxxxxxxxxxxxxxxx

# After every usable meeting, complete exact-match finished issues and create
# the minimum set of non-duplicate committed next actions. Set to 0 for an
# emergency kill switch. Dry runs never write regardless of this setting.
RECAP_LINEAR_ENABLED=1

# --- Identity / routing ---
# Everyone whose email ends @RECAP_INTERNAL_DOMAIN is "internal". Outside guests
# are excluded from the internal debrief and only ever get the client recap.
RECAP_INTERNAL_DOMAIN=yourcompany.com
# Fallback inbox for ambiguous meetings and send failures (a draft is held here).
RECAP_OWNER_EMAIL=you@yourcompany.com
# Optional status pings via the gen CLI's `send` verb (leave blank to disable).
# RECAP_NOTIFY_TARGET=telegram:000000000

# --- Generation (pluggable LLM CLI) ---
# Any CLI invoked as `<bin> -m <model> -z <prompt>` that prints email HTML to
# stdout. Swap in your own wrapper around the model of your choice.
RECAP_GEN_BIN=hermes
RECAP_GEN_MODEL=gpt-5
# RECAP_GEN_TIMEOUT=600

# --- Paths (optional overrides) ---
# RECAP_STATE_DIR=~/.recap/state
# RECAP_WRITING_SPEC=./templates/writing_spec.md
# RECAP_RECEIVER_PORT=8765
